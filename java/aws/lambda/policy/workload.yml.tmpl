# Load under the data branch: conjur policy load -b data -f workload.yml
- !policy
  id: ${POLICY_ID}
  body:
  - !variable db-password

  - !group secrets-users
  - !permit
    role: !group secrets-users
    privilege: [ read, execute ]
    resource: !variable db-password

  # The host ID must be <aws-account-id>/<iam-role-name>.
  - !host
    id: ${AWS_ACCOUNT_ID}/${ROLE_NAME}
  - !grant
    role: !group secrets-users
    member: !host ${AWS_ACCOUNT_ID}/${ROLE_NAME}
